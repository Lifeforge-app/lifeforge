{
  "name": "@lifeforge/module-registry",
  "version": "0.0.1",
  "description": "Shared module identity and path registry for the LifeForge server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@lifeforge/configs": "workspace:*",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.6"
  }
}
